# Otter 配置(复制为 .env 并填入你的 key;查找顺序:环境变量 > ./.env > ~/.otter/.env)
# OpenAI 兼容端点(DeepSeek / OpenAI / Qwen / Ollama 同协议)
OTTER_BASE_URL=https://api.deepseek.com
OTTER_API_KEY=sk-你的key
OTTER_MODEL=deepseek-v4-flash
# 可选:单次任务最大步数(默认 30)
# OTTER_MAX_STEPS=30

# ── Anthropic 原生(2026-09-24):base_url 换成 https://api.anthropic.com 即自动走原生
# Messages API(adapter 工厂按 base_url 判定);也可显式 OTTER_PROVIDER=anthropic / openai
# OTTER_BASE_URL=https://api.anthropic.com
# OTTER_MODEL=claude-sonnet-5
# OTTER_MAX_TOKENS=8192   # Anthropic max_tokens 必填(默认 8192;OpenAI 端点忽略此值)
# ── Replan 领域扩展示例(2026-09-24 起默认关闭,保持通用编码助理身份):
# 显式置 1 装载排程沙盘工具(get_schedule/simulate_change/commit_reschedule)
# OTTER_REPLAN=0
# ── RAG 向量检索(2026-09-29):配置任意 OpenAI 兼容 /embeddings 端点即启用
# 语义召回(记忆 memory_search 与 doc_search 文档检索共用);
# 不配置则自动退纯词法(FTS5),行为不变。
# OTTER_EMBED_MODEL=text-embedding-v3          # 如 Qwen text-embedding-v3 / Ollama bge-m3 / OpenAI text-embedding-3-small
# OTTER_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # 缺省复用 OTTER_BASE_URL
